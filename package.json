{
  "name": "nutricoach-ai",
  "version": "1.0.0",
  "private": true,
  "description": "NutriCoach AI monorepo platform bootstrap.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "clean": "turbo run clean --concurrency=1",
    "deploy:web": "vercel --prod",
    "deploy:mobile:preview": "pnpm --filter @nutricoach/mobile build:preview"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "eslint": "^9.39.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "pnpm": "^11.10.0",
    "prettier": "^3.9.4",
    "turbo": "^2.10.4",
    "typescript": "^6.0.3"
  }
}
